{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:embodied-agent:protocol:v0",
  "title": "Embodied Agent body-brain protocol v0: JSON envelope",
  "description": "One JSON text frame. See protocol/v0.md for the rules the schema cannot express (direction, the sender's own timestamp, ordering, id sequence, binary pairing, authentication).",
  "type": "object",
  "required": [
    "v",
    "type",
    "id",
    "reply_to",
    "ts_body",
    "ts_brain",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 0
    },
    "type": {
      "enum": [
        "hello",
        "auth",
        "heartbeat",
        "pose",
        "tracking_state",
        "image",
        "audio_in",
        "audio_out",
        "speak_local",
        "event",
        "command",
        "ack",
        "error",
        "echo"
      ]
    },
    "id": {
      "$ref": "#/$defs/msg_id"
    },
    "reply_to": {
      "oneOf": [
        {
          "$ref": "#/$defs/msg_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "ts_body": {
      "$ref": "#/$defs/ts_or_null"
    },
    "ts_brain": {
      "$ref": "#/$defs/ts_or_null"
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "hello"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/hello"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "auth"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/auth"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "heartbeat"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/heartbeat"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "pose"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/pose"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tracking_state"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/tracking_state"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "image"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/image"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "audio_in"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/audio_in"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "audio_out"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/audio_out"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "speak_local"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/speak_local"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "event"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/event"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "command"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/command"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ack"
          }
        }
      },
      "then": {
        "properties": {
          "reply_to": {
            "$ref": "#/$defs/msg_id"
          },
          "payload": {
            "$ref": "#/$defs/ack"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/error"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "echo"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/echo"
          }
        }
      }
    }
  ],
  "$defs": {
    "msg_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "ts": {
      "description": "Microseconds on the stamping side's monotonic clock. Never negative; at most 2^53-1 so it is exact in every JSON parser.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ts_or_null": {
      "oneOf": [
        {
          "$ref": "#/$defs/ts"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "ident": {
      "description": "An identifier chosen by one side. Safe as a file name: no path separators, does not start with a dot.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,63}$"
    },
    "hex256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "byte_length": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8388608
    },
    "command_name": {
      "enum": [
        "get_status",
        "capture_image",
        "start_audio_in",
        "stop_audio_in",
        "stop_audio_out",
        "set_pose_rate"
      ]
    },
    "error_code": {
      "enum": [
        "bad_json",
        "bad_envelope",
        "bad_payload",
        "unsupported_version",
        "unknown_type",
        "wrong_direction",
        "bad_sequence",
        "bad_binary",
        "too_large",
        "unknown_command",
        "bad_args",
        "not_implemented",
        "busy",
        "internal",
        "unauthorized"
      ]
    },
    "pose_body": {
      "type": "object",
      "required": [
        "frame_id",
        "position_m",
        "orientation_xyzw"
      ],
      "properties": {
        "frame_id": {
          "$ref": "#/$defs/ident"
        },
        "position_m": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "orientation_xyzw": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "hello": {
      "type": "object",
      "required": [
        "role",
        "software",
        "capabilities"
      ],
      "properties": {
        "role": {
          "enum": [
            "body",
            "brain"
          ]
        },
        "software": {
          "allOf": [
            {
              "$ref": "#/$defs/text"
            }
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "versions": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name"
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name"
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "boot_id": {
          "$ref": "#/$defs/ident"
        },
        "session_id": {
          "$ref": "#/$defs/ident"
        },
        "wall_time_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        },
        "heartbeat_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "liveness_timeout_ms": {
          "type": "integer",
          "minimum": 300,
          "maximum": 300000
        },
        "max_binary_bytes": {
          "$ref": "#/$defs/byte_length"
        },
        "auth": {
          "description": "Section 4.2: this side's fresh nonce.",
          "type": "object",
          "required": [
            "nonce"
          ],
          "properties": {
            "nonce": {
              "$ref": "#/$defs/hex256"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "brain"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "required": [
              "session_id",
              "auth"
            ]
          }
        }
      ]
    },
    "auth": {
      "type": "object",
      "required": [
        "mac"
      ],
      "properties": {
        "mac": {
          "$ref": "#/$defs/hex256"
        }
      }
    },
    "heartbeat": {
      "type": "object",
      "properties": {
        "offset_us": {
          "type": [
            "integer",
            "null"
          ]
        },
        "rtt_us": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "pose": {
      "allOf": [
        {
          "$ref": "#/$defs/pose_body"
        },
        {
          "type": "object",
          "required": [
            "tracking"
          ],
          "properties": {
            "tracking": {
              "enum": [
                "ok",
                "limited",
                "lost"
              ]
            }
          }
        }
      ]
    },
    "tracking_state": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "ok",
            "limited",
            "lost"
          ]
        },
        "reason": {
          "oneOf": [
            {
              "$ref": "#/$defs/name"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "image": {
      "type": "object",
      "required": [
        "encoding",
        "width",
        "height",
        "byte_length"
      ],
      "properties": {
        "encoding": {
          "enum": [
            "jpeg"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "pose": {
          "$ref": "#/$defs/pose_body"
        }
      }
    },
    "pcm": {
      "type": "object",
      "required": [
        "encoding",
        "sample_rate",
        "channels",
        "seq",
        "byte_length"
      ],
      "properties": {
        "encoding": {
          "enum": [
            "pcm_s16le"
          ]
        },
        "sample_rate": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 192000
        },
        "channels": {
          "enum": [
            1,
            2
          ]
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "byte_length": {
          "$ref": "#/$defs/byte_length"
        }
      }
    },
    "audio_in": {
      "allOf": [
        {
          "$ref": "#/$defs/pcm"
        },
        {
          "type": "object",
          "required": [
            "stream_id"
          ],
          "properties": {
            "stream_id": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "audio_out": {
      "allOf": [
        {
          "$ref": "#/$defs/pcm"
        },
        {
          "type": "object",
          "required": [
            "utterance_id",
            "final"
          ],
          "properties": {
            "utterance_id": {
              "$ref": "#/$defs/ident"
            },
            "final": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "speak_local": {
      "type": "object",
      "required": [
        "utterance_id",
        "text",
        "interrupt"
      ],
      "properties": {
        "utterance_id": {
          "$ref": "#/$defs/ident"
        },
        "text": {
          "allOf": [
            {
              "$ref": "#/$defs/text"
            }
          ],
          "minLength": 1,
          "maxLength": 2000
        },
        "interrupt": {
          "type": "boolean"
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "name",
        "data"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "data": {
          "type": "object"
        }
      }
    },
    "command": {
      "type": "object",
      "required": [
        "name",
        "args"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/command_name"
        },
        "args": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "name": {
                "const": "capture_image"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "max_edge"
                ],
                "properties": {
                  "max_edge": {
                    "type": "integer",
                    "minimum": 64,
                    "maximum": 4096
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "set_pose_rate"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "hz"
                ],
                "properties": {
                  "hz": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 30
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "enum": [
                  "get_status",
                  "start_audio_in",
                  "stop_audio_in",
                  "stop_audio_out"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "type": "object",
                "maxProperties": 0
              }
            }
          }
        }
      ]
    },
    "ack": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "ok"
        },
        "result": {
          "type": "object"
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "fatal"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/error_code"
        },
        "message": {
          "allOf": [
            {
              "$ref": "#/$defs/text"
            }
          ],
          "maxLength": 500
        },
        "fatal": {
          "type": "boolean"
        }
      }
    },
    "echo": {
      "type": "object",
      "required": [
        "seq",
        "text",
        "byte_length",
        "crc32"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "allOf": [
            {
              "$ref": "#/$defs/text"
            }
          ],
          "maxLength": 4096
        },
        "byte_length": {
          "$ref": "#/$defs/byte_length"
        },
        "crc32": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "text": {
      "description": "Free text from the peer: no control characters (no newlines), so it cannot forge log lines.",
      "type": "string",
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    }
  }
}
