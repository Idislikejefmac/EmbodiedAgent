<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the adb test hook. Callers need android.permission.DUMP, a
     signature|privileged|development permission: the adb shell holds it, as can preinstalled privileged
     apps and any app that declares it and is granted it with `adb shell pm grant`. Ordinary installed
     apps cannot obtain it on their own. Release builds do not contain this receiver. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".DebugCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
