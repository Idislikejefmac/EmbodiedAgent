<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing of this app goes to cloud backup or device-to-device transfer, so the pairing
     token (shared_prefs/link_auth.xml) never leaves the phone. allowBackup="false" alone does not stop
     device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
