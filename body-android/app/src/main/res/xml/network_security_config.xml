<?xml version="1.0" encoding="utf-8"?>
<!-- Protocol v0 runs over plain ws:// to the brain. Cleartext is allowed only to the
     adb reverse endpoint on the phone itself. A direct WiFi address must be added here, and
     should first get transport encryption (protocol/v0.md open question 3); the link is
     already mutually authenticated (section 4.2). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
